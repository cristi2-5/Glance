# Copy this file to `.env` and fill in the real values.
# `.env` must NEVER be committed to git.

# Application
DEBUG=false

# Database / Chroma
# Leave these unset unless you want a non-default location. The defaults in
# app/core/config.py are absolute paths under backend/, so they resolve the
# same from any working directory; a relative value here would not.
# DATABASE_URL=
# CHROMA_PERSIST_DIR=

# Auth / JWT
# REQUIRED — an empty value is read as an empty string, NOT as the default,
# so tokens would be signed with no secret at all. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI provider — "groq" (cloud, default) or "ollama" (fully local fallback).
# Embeddings always run locally via Ollama regardless of this setting.
AI_PROVIDER=groq

# Groq Cloud — required when AI_PROVIDER=groq. Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=1024
# Reasoning budget per model. The accepted values differ by model family
# and a wrong one is a hard 400: Qwen3 takes none/default, gpt-oss takes
# only low/medium/high. Change these together with the model names above.
GROQ_VISION_REASONING_EFFORT=none
GROQ_LLM_REASONING_EFFORT=low

# Ollama — used for embeddings always, and for vision/LLM generation when
# AI_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# The embedding model is small (~275 MB) and stays resident, so ingestion
# doesn't pay a reload on every book.
OLLAMA_EMBEDDING_KEEP_ALIVE=1h
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Catalog lookup
# Google Books without a key shares an anonymous quota that is routinely
# exhausted (HTTP 429 on every request). Create a free key (1,000 req/day):
#   https://console.cloud.google.com/apis/library/books.googleapis.com
# Leave empty to rely on the keyless Open Library fallback instead.
GOOGLE_BOOKS_API_KEY=

# Content sources / cache (Module 4)
# Only official APIs — no scraping. Wikipedia requires a descriptive
# User-Agent naming the app and a contact point; requests without one are
# throttled or refused. Put a real contact address here.
SOURCE_USER_AGENT=Glance/0.1 (book summary app; you@example.com)
# Which Wikipedia editions to search, in order, stopping at the first that
# recognizes the title. JSON list. English first because its articles carry
# far more critical reception; Romanian second because a Romanian edition
# is scanned under its Romanian title, which en.wikipedia has never heard
# of — "Căpitan la cincisprezece ani" returns nothing there and is a full
# article on ro.
WIKIPEDIA_LANGUAGES=["en","ro"]
WIKIPEDIA_TIMEOUT_SECONDS=10
# How long a cached book stays fresh before its sources are re-fetched.
BOOK_CACHE_TTL_DAYS=30
# Books the catalogs had nothing on expire much sooner: emptiness is
# usually a bare catalog record or a briefly degraded source, not a fact,
# and caching it for the full TTL makes the gap permanent for the user.
EMPTY_BOOK_CACHE_TTL_HOURS=6
# Last-resort cover image: a Wikipedia article's lead image, used only
# when Google Books and Open Library both have none. Those images are
# usually non-free cover scans held under a fair-use exemption that does
# not extend to a distributed app — this is on only because the build is
# private. Set to false before publishing or sharing the app.
WIKIPEDIA_COVER_FALLBACK=true

# RAG (Module 5)
# Chunk size is a retrieval trade-off, not a model limit: a cited excerpt
# too short to read on its own is useless on the client, and one too long
# ranks imprecisely. ~500 tokens is roughly one coherent paragraph.
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=50
# Retrieval depth per aspect (premise / themes / reception), and the
# ceiling on total context sent to the summary model.
RAG_RETRIEVAL_TOP_K=4
RAG_MAX_CONTEXT_CHUNKS=8
RAG_MAX_OUTPUT_TOKENS=2048

# Recommendations (Module 6b)
# Candidates come from the catalogs, queried by the genres and authors
# derived from books rated 4+ — not from the RAG corpus, which holds only
# books already scanned and is exactly the set that must be filtered out.
# How many derived labels seed that discovery: each one is a query per
# catalog, and the sixth favourite genre characterises a reader far less
# than the first.
RECOMMENDATION_SEED_GENRES=3
RECOMMENDATION_SEED_AUTHORS=2
RECOMMENDATION_RESULTS_PER_QUERY=12
# Cap on new books one discovery run may persist. Bounds both the local
# embedding work and how fast the shared candidate pool grows.
RECOMMENDATION_MAX_NEW_CANDIDATES=60
RECOMMENDATION_DEFAULT_LIMIT=12
# Floor on similarity to the profile vector. Low on purpose: the pool is
# already seeded from this reader's own tastes, so a high floor empties
# the list rather than sharpening it.
RECOMMENDATION_MIN_SCORE=0.20
# How long a discovery run stays good for. A change in the reader's
# derived preferences invalidates it independently of this clock.
RECOMMENDATION_CANDIDATE_TTL_HOURS=24
# ...but a run during which a catalog went down expires far sooner, so one
# bad minute doesn't cost the reader a day of thin recommendations.
RECOMMENDATION_DEGRADED_TTL_HOURS=1
RECOMMENDATION_DOCUMENT_MAX_CHARS=1200
# Pause between two queries to the SAME catalog. Measured, not guessed:
# fired concurrently, five discovery queries drew a 503 from Google Books
# on 16 of 20 requests; paced one second apart the identical queries
# returned 200 on 5 of 5. Google sheds load on burst rate per key — the
# query parameters make no difference. Lower this and the 503s come back.
RECOMMENDATION_QUERY_SPACING_SECONDS=1.0
# Extra attempts per discovery query, deliberately below
# CATALOG_MAX_RETRIES: discovery has one query per seed and abandons a
# source after its first unavailable answer, so retrying each three times
# against a host that is down turns a daily refresh into a long request.
RECOMMENDATION_DISCOVERY_RETRIES=1

# Upload
MAX_UPLOAD_SIZE_BYTES=8388608

# CORS — only relevant for browser clients (Expo Web, the /dev test page).
# The native Expo Go app doesn't go through CORS. JSON list of allowed origins.
CORS_ORIGINS=["*"]
