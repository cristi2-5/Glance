# Copy this file to `.env` and fill in the real values.
# `.env` must NEVER be committed to git.

# Application
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/glance.db

# Chroma (vector DB)
CHROMA_PERSIST_DIR=./data/chroma

# Auth / JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Upload
MAX_UPLOAD_SIZE_BYTES=8388608

# CORS — only relevant for browser clients (Expo Web, the /dev test page).
# The native Expo Go app doesn't go through CORS. JSON list of allowed origins.
CORS_ORIGINS=["*"]
